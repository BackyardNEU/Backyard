# Frontend (browser-safe — exposed in bundle)
VITE_SUPABASE_URL="https://<your-project>.supabase.co"
VITE_SUPABASE_KEY="<anon-key-from-supabase-dashboard>"

# Backend (server-only — never expose to browser)
SUPABASE_URL="https://<your-project>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key-from-supabase-dashboard>"
PORT=3001

# Production-only: set to deployed frontend origin (e.g. https://backyard.vercel.app)
FRONTEND_URL=

# Comma-separated Supabase user UUIDs with admin access (find your UUID in Supabase → Authentication → Users)
ADMIN_USER_IDS=
